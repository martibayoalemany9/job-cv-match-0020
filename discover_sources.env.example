# Copy to discover_sources.env and fill secrets (never commit real keys).
#   cp discover_sources.env.example discover_sources.env

# --- Master toggles (discover_all_sources.py) ---
ENABLE_GREENHOUSE=1
ENABLE_LEVER=1
ENABLE_APIFY=1
ENABLE_THEIRSTACK=1
ENABLE_PREDICTLEADS=1
ENABLE_GMAIL_ALERTS=1
ENABLE_EFC=0
ENABLE_STEPSTONE=1
RUN_EFC=0
RUN_STEPSTONE=1

# --- Apify / Crawlee cloud actors ---
# APIFY_TOKEN=
# APIFY_ACTOR_ID=username~job-board-scraper
# APIFY_MAX_ITEMS=50
# APIFY_INPUT_JSON=

# --- Bright Data (proxy when boards block you) ---
# BRIGHTDATA_CUSTOMER=
# BRIGHTDATA_ZONE=
# BRIGHTDATA_PASSWORD=
# BRIGHTDATA_HOST=brd.superproxy.io
# BRIGHTDATA_PORT=22225
# BRIGHTDATA_PROXY_URL=

# --- Oxylabs ---
# OXYLABS_USERNAME=
# OXYLABS_PASSWORD=
# OXYLABS_HOST=pr.oxylabs.io
# OXYLABS_PORT=7777
# OXYLABS_PROXY_URL=

# Or single override:
# DISCOVER_PROXY_URL=http://user:pass@proxy-host:port

# --- TheirStack ---
# THEIRSTACK_API_KEY=
# THEIRSTACK_LIMIT=40
# THEIRSTACK_MAX_AGE_DAYS=30
# THEIRSTACK_BASE=https://api.theirstack.com/v1

# --- PredictLeads ---
# PREDICTLEADS_API_KEY=
# PREDICTLEADS_API_TOKEN=
# PREDICTLEADS_DOMAINS=sap.com,siemens.com,bosch.com,infineon.com,n26.com
# PREDICTLEADS_BASE=https://predictleads.com/api/v2

# --- Stepstone ---
STEPSTONE_QUERY=Technology Lead OR Software Architect
STEPSTONE_LOCATIONS=Karlsruhe,Stuttgart,München,Frankfurt,Berlin,Remote

# --- eFC rings (heavy) ---
EFC_MAX_RINGS=4
EFC_TIMEOUT_SEC=600

# --- Gmail cloud function ---
# QUEUE_WEBHOOK_URL=https://your-endpoint/ingest
